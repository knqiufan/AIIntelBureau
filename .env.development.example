# Development profile overlay. Copy .env.example to .env first, then apply
# these values when developing against a locally embedded seekdb instance. The
# direct OceanBase/MySQL-compatible settings in .env.example are ignored.
DEMO_MODE=degrade
DEMO_MEMORY_ADAPTER=production
DEMO_WARMUP=false
DEMO_DATA_RETENTION=persistent
SEEKDB_MODE=embedded
SEEKDB_PATH=./data/seekdb
# Fill EMBEDDING_API_KEY, EMBEDDING_MODEL and EMBEDDING_DIMENSIONS in .env.
