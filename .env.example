# AI 情报局：唯一的运行配置入口。复制为 .env 后填写，不要提交 .env。

# ---- Demo runtime ------------------------------------------------------------
# Set development only for a trusted local machine. Production refuses to
# start unless its role-specific credentials, HTTPS proxy, cookie, and CORS
# requirements below are all explicitly configured.
DEMO_ENV=development
DEMO_API_PUBLIC_PORT=8000
DEMO_WEB_PUBLIC_PORT=8080
DEMO_MODE=degrade
DEMO_ALLOW_FREEFORM_WHISPER=true
# Comma-separated terms blocked in freeform audience input. Phone and mainland
# identity-number patterns are always rejected and neither value is logged.
DEMO_DISALLOWED_WHISPER_TERMS=身份证,手机号,银行卡号,真实住址
# Per case and role; 0 disables the server-side freeform whisper quota.
DEMO_WHISPER_RATE_LIMIT_PER_MINUTE=6
# Development permits open local access when both keys are blank. Production
# requires distinct values of at least 16 characters for both principals.
# Never reuse the operator key for the stage: a shared credential cannot enforce
# the private-memory boundary.
DEMO_OPERATOR_ACCESS_KEY=
DEMO_STAGE_ACCESS_KEY=
# Set true only when HTTPS terminates in front of this service.
DEMO_ACCESS_COOKIE_SECURE=false
# Production requires this acknowledgement that the reverse proxy terminates
# HTTPS and forwards requests only from a trusted internal network.
DEMO_TRUSTED_HTTPS_PROXY=false
# Test-only endpoint. It is omitted from the application route table by default
# and may not be enabled in production.
DEMO_ENABLE_SMOKE=false
DEMO_STATE_DB_PATH=./data/ai_intel_bureau_state.sqlite3
DEMO_DATA_RETENTION=persistent
DEMO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
DEMO_LOG_LEVEL=INFO
# Only needed when the browser API is hosted at a different origin. Empty means
# Vite development proxy / production same-origin Nginx.
VITE_API_BASE_URL=
# UI development data source: api (default) or mock. Mock uses the checked-in P1
# JSON fixture and replays events at the delay below; it never contacts a server.
VITE_DEMO_DATA_SOURCE=api
VITE_MOCK_EVENT_DELAY_MS=0
# Optional development-proxy target. Empty uses http://127.0.0.1:8000.
DEMO_API_URL=
# Docker production enables this after remote service configuration is complete.
DEMO_WARMUP=true
# Test-only. Keep production as production; CI switches it to in_memory.
DEMO_MEMORY_ADAPTER=production

# ---- P4 advanced laboratory -------------------------------------------------
# The publication audit is a read-only projection of demo_events and does not
# scan private memories. All experimental capabilities stay opt-in.
DEMO_ADVANCED_FEATURES_ENABLED=true
DEMO_AUDIT_TIMELINE_ENABLED=true
# Public-material analyst: it only receives bulletin-board search results.
DEMO_BOARD_ANALYSIS_ENABLED=false
# Isolated anti-pattern fixture. It is only available when freeform whispers
# are also disabled, and it never queries the production memory gateway.
DEMO_UNSAFE_FIXTURE_ENABLED=false
# Development-only AgentMemory share_memory contract probe; never replaces the
# copy-to-board path used by the live demo.
DEMO_NATIVE_SHARE_EXPERIMENT_ENABLED=false

# ---- Direct cloud seekdb / OceanBase (default; MySQL-compatible connection) -
# PowerMem is installed in this application and calls pyobvector directly. Do
# not put a PowerMem HTTP endpoint here. SEEKDB_USER often includes tenant info,
# for example root@tenant#cluster; use the exact user accepted by your server.
SEEKDB_MODE=oceanbase
SEEKDB_HOST=
SEEKDB_PORT=2881
SEEKDB_USER=
SEEKDB_PASSWORD=
SEEKDB_POOL_RECYCLE_SECONDS=3600
SEEKDB_POOL_PRE_PING=true
SEEKDB_DATABASE=ai_intel_bureau
SEEKDB_COLLECTION=ai_intel_bureau_memories
SEEKDB_INDEX_TYPE=HNSW
SEEKDB_METRIC=cosine

# ---- Local embedded seekdb (set SEEKDB_MODE=embedded to activate) -----------
# It uses the configured embedding model below and stores data locally. Host,
# port and credential values above are ignored in this mode.
SEEKDB_PATH=./data/seekdb

# ---- Role LLM: OpenAI-compatible StepFun default ---------------------------
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=
LLM_MODEL=step-3.7-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=8

# ---- PowerMem embedding -----------------------------------------------------
# `openai` works with OpenAI-compatible services, including SiliconFlow. Use
# the API root (for example https://api.siliconflow.cn/v1), not /embeddings.
# `siliconflow` is also available as a provider-specific alternative.
# Fill the model name/dimensions that your provider actually serves.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.stepfun.com/step_plan/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL
EMBEDDING_DIMENSIONS=1024
# Send an OpenAI `dimensions` override. Set false for fixed-dimension models
# such as SiliconFlow BAAI/bge-m3; the vector table still uses the dimensions
# above.
EMBEDDING_PASS_DIMENSIONS=true
