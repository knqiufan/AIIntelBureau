# Test profile overlay. The test suite sets these values itself; use this only
# for manual no-network debugging after copying .env.example to .env.
DEMO_MODE=degrade
DEMO_MEMORY_ADAPTER=in_memory
DEMO_WARMUP=false
DEMO_DATA_RETENTION=ephemeral
DEMO_STATE_DB_PATH=:memory:
VITE_DEMO_DATA_SOURCE=mock
VITE_MOCK_EVENT_DELAY_MS=0
